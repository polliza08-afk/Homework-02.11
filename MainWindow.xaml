<Window x:Class="TestingSystem.MainForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система тестування: Основи ООП" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <!--Введення даних користувача-->
        <StackPanel x:Name="pnlRegistration" VerticalAlignment="Center" MaxWidth="400">
            <TextBlock Text="Введіть ваші дані для початку тесту" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <TextBlock Text="Ім'я:" Margin="0,5,0,2"/>
            <TextBox x:Name="txtFirstName" Height="28" Margin="0,0,0,10"/>
            <TextBlock Text="Прізвище:" Margin="0,5,0,2"/>
            <TextBox x:Name="txtLastName" Height="28" Margin="0,0,0,10"/>
            <TextBlock Text="Група або Email:" Margin="0,5,0,2"/>
            <TextBox x:Name="txtGroup" Height="28" Margin="0,0,0,20"/>
            <Button Content="Розпочати тест" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="StartTest_Click"/>
        </StackPanel>

        <!--Проходження тесту-->
        <Grid x:Name="pnlTest" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Таймер та номер питання-->
            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="lblTimer" Text="Час: 10:00" FontSize="16" FontWeight="Bold" Foreground="Red" DockPanel.Dock="Right"/>
                <TextBlock x:Name="lblQuestionNumber" Text="Питання 1 з 2" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
            </DockPanel>

            <!--Текст питання та варіанти-->
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="lblQuestionText" Text="Текст питання..." FontSize="16" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <StackPanel x:Name="pnlOptions" Margin="10,0,0,0">
                    <!--Варіанти додаються динамічно в коді-->
                </StackPanel>
            </StackPanel>

            <!--Кнопка наступного питання-->
            <Button Grid.Row="2" x:Name="btnNext" Content="Наступне питання" Width="150" Height="30" HorizontalAlignment="Right" Click="NextQuestion_Click"/>
        </Grid>

        <!--Результати-->
        <StackPanel x:Name="pnlResult" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="400">
            <TextBlock Text="Тест завершено!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="Green"/>
            <TextBlock x:Name="lblResultUser" Text="Користувач: ..." FontSize="14" Margin="0,5"/>
            <TextBlock x:Name="lblResultScore" Text="Оцінка: ..." FontSize="16" FontWeight="Bold" Margin="0,5"/>
            <TextBlock x:Name="lblResultTime" Text="Витрачений час: ..." FontSize="14" Margin="0,5,0,20"/>
            <Button Content="Пройти знову" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="Restart_Click"/>
        </StackPanel>
    </Grid>
</Window>